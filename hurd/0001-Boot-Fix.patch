+/* Read exactly LEN bytes from FD, returning 0 on success.  */
+static int
+read_full (int fd, void *buf, size_t len)
+{
+  char *p = buf;
+  while (len > 0)
+    {
+      ssize_t n = read (fd, p, len);
+      if (n == 0)
+	return -1;
+      if (n < 0)
+	{
+	  if (errno == EINTR)
+	    continue;
+	  return -1;
+	}
+      p += n;
+      len -= n;
+    }
+  return 0;
+}
